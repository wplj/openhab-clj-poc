{:paths ["src"]

 :deps {org.clojure/clojure       {:mvn/version "1.12.4"}
        org.clojure/core.async    {:mvn/version "1.9.865"}
        org.clojure/spec.alpha    {:mvn/version "0.6.249"}
        org.clojure/tools.logging {:mvn/version "1.3.1"}
        clj-http/clj-http         {:mvn/version "3.13.1"}
        cheshire/cheshire         {:mvn/version "6.2.0"}
        http-kit/http-kit         {:mvn/version "2.8.1"}
        metosin/reitit-ring       {:mvn/version "0.10.1"}
        ring/ring-core            {:mvn/version "1.15.3"}}

 :aliases
 {:dev  {:extra-paths ["dev" "test"]
         :extra-deps  {nrepl/nrepl {:mvn/version "1.6.0"}}}
  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner"
                       "-d" "test"]}
  :kaocha {:extra-paths ["test"]
           :extra-deps  {lambdaisland/kaocha {:mvn/version "1.91.1392"}}}
  :lint {:extra-paths ["test"]
         :extra-deps {clj-kondo/clj-kondo {:mvn/version "2026.04.15"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"]}}}
